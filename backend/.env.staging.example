# Staging configuration reference — PLACEHOLDERS ONLY. Never commit real values.
#
# On Render these are set by render.yaml (the Blueprint) and the database
# values are injected by Render itself; you normally never fill this file in.
# It documents the effective staging configuration and lets you run the
# release image locally in staging mode:
#   docker run --env-file backend/.env.staging -p 8080:10000 ghcr.io/r3zv/dietnow:<sha>
# See docs/DEPLOYMENT.md.

APP_ENV=staging
PORT=10000                     # set by Render
DB_AUTO_MIGRATE=true
STATIC_DIR=/app/web            # set in the image

DB_HOST=<from Render: dietnow-staging-db internal host>
DB_PORT=5432
DB_USER=dietnow
DB_PASSWORD=<from Render: generated, never copy into git>
DB_NAME=dietnow
DB_SSLMODE=prefer
DB_LOG_LEVEL=warn
DB_MAX_OPEN_CONNS=10

# The image serves the frontend and the API on the same origin
# (https://dietnow-staging.onrender.com), so no cross-origin access is needed.
API_ALLOWED_ORIGINS=

SESSION_TTL_HOURS=168
SESSION_IDLE_MINUTES=1440
# __Host- prefix: browser enforces Secure, Path=/ and no Domain attribute.
SESSION_COOKIE_NAME=__Host-dietnow_session
COOKIE_SECURE=true
COOKIE_DOMAIN=
BCRYPT_COST=12
