# Staging template. Copy to `.env.staging` (git-ignored) or, preferably, set
# these as secrets/variables in the hosting platform. Never commit real values.

APP_ENV=staging
HTTP_ADDR=:8080

DB_HOST=<staging-db-host>
DB_PORT=5432
DB_USER=dietnow
DB_PASSWORD=<set-in-secret-manager>
DB_NAME=dietnow
DB_SSLMODE=require
DB_LOG_LEVEL=warn

# The staging frontend origin(s). Serve the API on the same site as the
# frontend (e.g. https://staging.dietnow.app + https://api.staging.dietnow.app)
# so the SameSite=Lax session cookie is sent with API requests.
ALLOWED_ORIGINS=https://<staging-frontend-host>

SESSION_TTL_HOURS=168
SESSION_IDLE_MINUTES=1440
# __Host- prefix: browser enforces Secure, Path=/ and no Domain attribute.
SESSION_COOKIE_NAME=__Host-dietnow_session
COOKIE_SECURE=true
COOKIE_DOMAIN=
BCRYPT_COST=12
