# DietNow backend configuration — PLACEHOLDERS ONLY. Never commit real secrets.
# Copy to `.env` (git-ignored) and fill in values:
#   cp .env.example .env            (PowerShell: Copy-Item .env.example .env)
# docker-compose.yml and the Go commands (api, migrate, seed) all read this file.
# Variables already set in the real environment take precedence.
# Staging values: see .env.staging.example and docs/DEPLOYMENT.md.

# --- HTTP API (cmd/api) ---------------------------------------------------
# development | test | staging | production. Anything except development/test
# enables strict startup checks (COOKIE_SECURE=true, real DB_PASSWORD,
# BCRYPT_COST>=10, database must be reachable).
APP_ENV=development
# Port the API listens on (the frontend dev server proxies /api here).
# Hosting platforms that set PORT (Render) override this.
API_PORT=8080
# Comma-separated browser origins allowed to call the API cross-origin with
# cookies. Leave empty for local dev (the Vite proxy makes requests same-origin).
API_ALLOWED_ORIGINS=
# Directory with the built frontend to serve from the API (set in the Docker
# image). Leave empty locally; use `npm run dev` instead.
STATIC_DIR=
# Apply migrations + the reference food catalog at startup.
DB_AUTO_MIGRATE=true

# --- PostgreSQL ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=dietnow
DB_PASSWORD=change-me-local-db-password
DB_NAME=dietnow
DB_SSLMODE=disable

# Connection pool tuning (optional; sane defaults applied if unset).
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=60

# GORM log level: silent | error | warn | info
DB_LOG_LEVEL=warn

# --- Authentication / sessions (see AUTH.md) --------------------------------
SESSION_TTL_HOURS=168          # absolute session lifetime (7 days)
SESSION_IDLE_MINUTES=1440      # logged out after 24h without activity
SESSION_COOKIE_NAME=dietnow_session
COOKIE_SECURE=false            # http://localhost has no TLS; MUST be true on staging/prod
COOKIE_DOMAIN=                 # empty = host-only cookie (recommended)
BCRYPT_COST=12
