# Copy to `.env` and adjust. docker-compose.yml and the Go app both read these.
DB_HOST=localhost
DB_PORT=5432
DB_USER=dietnow
DB_PASSWORD=dietnow_dev_pw
DB_NAME=dietnow
DB_SSLMODE=disable

# Connection pool tuning (optional; sane defaults applied if unset).
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=60

# GORM log level: silent | error | warn | info
DB_LOG_LEVEL=warn

# --- HTTP API (go run ./cmd/api) ---
# local | staging | production. Anything other than "local" enables strict
# startup checks (COOKIE_SECURE=true, non-default DB_PASSWORD, BCRYPT_COST>=10).
APP_ENV=local
HTTP_ADDR=:8080
# Comma-separated frontend origins allowed to call the API with cookies (CORS).
# Exact scheme://host:port, no trailing slash. Typical Vite / Next dev servers:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Authentication / sessions (see AUTH.md) ---
SESSION_TTL_HOURS=168          # absolute session lifetime (7 days)
SESSION_IDLE_MINUTES=1440      # logged out after 24h without activity
SESSION_COOKIE_NAME=dietnow_session
COOKIE_SECURE=false            # http://localhost has no TLS; MUST be true on staging/prod
COOKIE_DOMAIN=                 # empty = host-only cookie (recommended)
BCRYPT_COST=12
