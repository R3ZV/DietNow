# DietNow frontend configuration — PLACEHOLDERS ONLY.
# Copy to `.env` (git-ignored):  cp .env.example .env  (PowerShell: Copy-Item .env.example .env)
#
# Only variables prefixed with VITE_ are read, and anything used in app code is
# bundled into the public JavaScript — NEVER put secrets here.

# Where the Vite dev server forwards /api requests (the Go API, see backend/.env API_PORT).
VITE_API_PROXY_TARGET=http://localhost:8080
